# Configuración de Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=plataforma_3f_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Configuración del Backend
PORT=3001
NODE_ENV=development

# Ingesta de Avisos (opcional)
INGESTA_MAX_AVISOS_LOTE=500

# Notificaciones Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Monitoreo y SLA de Scrapers en Horas (CARD-MTR-16)
SCRAPER_TIMEOUT_COLGADO_HORAS=2
SCRAPER_SLA_FRESCO_HORAS=24
SCRAPER_SLA_CRITICO_HORAS=48
